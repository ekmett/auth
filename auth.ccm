/** @file
 * @brief Authenticated computation with explicit prover and verifier databases.
 */
module;
#include <array>
#include <concepts>
#include <compare>
#include <cstdint>
#include <exception>
#include <span>
#include <type_traits>
#include <utility>
#include <vector>

export module auth;
export import auth.error;
import auth.hash;
import auth.serialization;

namespace auth {

/** @brief Records serialized openings in an owned proof buffer. */
export struct prover {
  /** @brief A resident value and its digest; copyability follows @p T.
   * @tparam T Payload type, serialized by its fields or member serialize method.
   * @note Serialization writes only the digest. Do not reopen a moved-from sealed value.
   */
  template<class T>
  class sealed {
    T value;
    digest hash{};

    /// @brief Retains a value together with the digest of its serialization.
    sealed(T value, digest hash) : value(std::move(value)), hash(hash) {}
    friend struct prover;

  public:
    /// @brief Compares digests without comparing resident values.
    bool operator==(const sealed& other) const { return hash == other.hash; }
    /// @brief Orders sealed values lexicographically by digest.
    auto operator<=>(const sealed& other) const { return hash <=> other.hash; }

  private:
    friend struct auth::writer;
    friend struct auth::reader;

    /// @brief Writes the digest without serializing the resident value.
    template<class Stream>
    void serialize(Stream& stream) const {
      // Invariant: prover sealed values are only serialized with a writing stream.
      stream(hash);
    }
  };

  bytes proof; ///< Concatenated openings, without external framing.

  /** @brief Hashes a value and retains it in a sealed value without changing the proof.
   * @param value Payload copied from an lvalue or moved from an rvalue.
   * @return A sealed value owning the payload and its SHA-256 digest.
   * @note Serialization, allocation, and payload construction exceptions propagate.
   */
  template<class T>
  sealed<T> seal(T value) const {
    auto hash = sha256(encode(value));
    return {std::move(value), hash};
  }

  /** @brief Appends an opening to the proof and returns its resident value.
   * @param p Sealed value copied from an lvalue when copyable, or moved from an rvalue.
   * @return The payload moved out of the local sealed value.
   * @note Each call appends another opening. If returning the payload throws,
   *       the serialized opening has already been appended.
   */
  template<class T>
  T unseal(sealed<T> p) {
    auto data = encode(p.value);
    proof.insert(proof.end(), data.begin(), data.end());
    return std::move(p.value);
  }
};

/** @brief Reconstructs and verifies openings from a borrowed proof buffer.
 * @note The proof storage must outlive the verifier and remain unchanged.
 */
export struct verifier {
  /** @brief A copyable digest commitment with no resident payload.
   * @tparam T Type reconstructed when this sealed value is opened.
   */
  template<class T>
  class sealed {
    digest hash{};
    /// @brief Constructs a commitment from a digest.
    explicit sealed(digest hash) : hash(hash) {}
    friend struct verifier;

  public:
    /// @brief Initializes an all-zero digest, ready for deserialization.
    sealed() = default;
    /// @brief Compares and orders sealed values by digest.
    auto operator<=>(const sealed&) const = default;

  private:
    friend struct auth::writer;
    friend struct auth::reader;

    /// @brief Reads or writes the digest according to the stream direction.
    template<class Self, class Stream>
    void serialize(this Self& self, Stream& stream) { stream(self.hash); }
  };

  /** @brief Starts replay at the beginning of a borrowed proof.
   * @param proof Immutable serialized openings whose storage outlives this verifier.
   */
  explicit verifier(std::span<const std::uint8_t> proof)
    : position(proof.data()), end(proof.subspan(proof.size()).data()) {}
  /// @brief Rejects a temporary owning buffer that would leave dangling pointers.
  verifier(bytes&&) = delete;

  /** @brief Computes a digest-only sealed value without reading the proof.
   * @param value Payload to serialize and hash; it is not retained.
   * @return A commitment with the same digest as prover::seal for the same encoding.
   * @note Serialization, allocation, and payload construction exceptions propagate.
   */
  template<class T>
  sealed<T> seal(T value) const {
    return sealed<T>{sha256(encode(value))};
  }

  /** @brief Decodes the next value and checks the digest of exactly its consumed bytes.
   * @param p Commitment to the next serialized value.
   * @return The reconstructed payload.
   * @throws auth_error If input is truncated, malformed, or does not match the digest.
   * @note The cursor advances only after successful return construction. Any failure
   *       leaves it unchanged. A zero-byte value does not advance the cursor.
   */
  template<class T>
  T unseal(sealed<T> p) {
    auto [value, next] = decode<T>({position, end});
    if (sha256({position, next}) != p.hash) throw auth_error("sealed hash mismatch");
    if constexpr (std::is_nothrow_move_constructible_v<T>) {
      position = next;
      return std::move(value);
    } else {
      // Return construction precedes local destruction; commit only on success.
      struct advance_on_success {
        const std::uint8_t*& position;
        const std::uint8_t* next;
        int exceptions = std::uncaught_exceptions();
        ~advance_on_success() {
          if (std::uncaught_exceptions() == exceptions) position = next;
        }
      } advance{position, next};
      return std::move(value);
    }
  }

  /** @brief Checks that replay consumed every proof byte.
   * @throws auth_error If unused bytes remain.
   */
  void finish() const {
    if (position != end) throw auth_error("unused proof bytes");
  }

private:
  const std::uint8_t* position;
  const std::uint8_t* const end;
};

/** @brief A database with associated sealed types and seal/unseal operations.
 * D is the database type, optionally reference-qualified.
 * @note The constraint checks uint32_t as a representative payload. Each actual
 *       call checks its own payload type; C++ concepts cannot quantify over all types.
 * @code
 * auto compute(db auto& db) {
 *   return db.unseal(db.seal(std::uint32_t{42}));
 * }
 * @endcode
 */
export template<class D>
concept db = requires(D& database, std::uint32_t value,
                      typename std::remove_cvref_t<D>::template sealed<std::uint32_t> p) {
  { database.seal(value) } ->
    std::same_as<typename std::remove_cvref_t<D>::template sealed<std::uint32_t>>;
  { database.unseal(std::move(p)) } -> std::same_as<std::uint32_t>;
};

/** @brief Selects a database's associated sealed type.
 * @tparam DB Type satisfying db; reference qualifiers are removed for lookup.
 * @tparam T Payload type.
 */
export template<db DB, class T>
using sealed = typename std::remove_cvref_t<DB>::template sealed<T>;

} // namespace auth
